# ==============================================
# NEON DATABASE CONFIGURATION
# ==============================================

# Primary Neon PostgreSQL connection string
# Get this from: Neon Dashboard > Connection Details
NEON_URL=postgresql://username:password@your-neon-host.neon.tech/neondb?sslmode=require

# Optional compatibility aliases used by the backend and migration scripts
DATABASE_URL_DIRECT=postgresql://username:password@your-neon-host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/neondb?sslmode=require

# ==============================================
# APPLICATION SETTINGS
# ==============================================

NODE_ENV=development
PORT=5000
JWT_SECRET=your-random-secret-key-here

# ==============================================
# NOTES
# ==============================================
#
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to git
# 3. For migration, NEON_URL is enough
# 4. Keep your Neon password secret
#
